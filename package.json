{
  "name": "sgap",
  "version": "0.1.0",
  "private": true,
  "description": "Slot Game Automation Platform — QA automation framework for iframe-based Phaser slot games",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "manifest:smoke": "pnpm build && node dist/platform/manifest/smoke-load-manifest.js",
    "registry:smoke": "pnpm build && node dist/controllers/registry/smoke-controller-registry.js",
    "ui:smoke": "pnpm build && node dist/ui/registry/smoke-ui-registry.js",
    "driver:smoke": "pnpm build && node dist/driver/smoke-playwright-game-driver.js",
    "platform:smoke": "pnpm build && node dist/platform/smoke-playwright-platform.js",
    "bet:smoke": "pnpm build && node dist/data/smoke-parse-bet-response.js",
    "verify:smoke": "pnpm build && node dist/verification/smoke-bet-verification.js",
    "reel:smoke": "pnpm build && node dist/verification/reel/smoke-reel-validation.js",
    "calibrate:reel": "pnpm build && node dist/driver/calibrate-reel-region.js",
    "probe:reel": "pnpm build && node dist/driver/probe-reel-region.js",
    "sheet:smoke": "pnpm build && node dist/reporting/smoke-sheet-append.js",
    "calibrate:spin": "pnpm build && node dist/driver/calibrate-spin-canvas.js",
    "calibrate:bet": "pnpm build && node dist/driver/calibrate-bet-canvas.js",
    "calibrate:autoplay": "pnpm build && node dist/driver/calibrate-autoplay-canvas.js",
    "calibrate:buy": "pnpm build && node dist/driver/calibrate-buy-feature-canvas.js",
    "calibrate:menu": "pnpm build && node dist/driver/calibrate-menu-canvas.js",
    "recorder": "pnpm build && node dist/tools/click-recorder/cli.js",
    "calibrate:record": "pnpm recorder",
    "scan:controls": "pnpm build && node dist/eye/scan-controls-cli.js",
    "probe:bet-dom": "pnpm build && node dist/driver/probe-bet-dom.js",
    "probe:spin": "pnpm build && node dist/driver/probe-staging-spin.js",
    "test": "playwright test --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:chrome": "playwright test --project=chrome",
    "test:edge": "playwright test --project=edge",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:staging": "node scripts/run-staging-tests.mjs",
    "test:parallel:staging": "node scripts/run-parallel-workers.mjs",
    "test:parallel:stop": "node scripts/stop-sgap-browsers.mjs",
    "test:parallel:allure": "node scripts/run-parallel-workers.mjs",
    "test:package:staging": "node scripts/run-package-games-staging.mjs",
    "test:scg:all": "node scripts/run-scg-all-staging.mjs",
    "qa": "node scripts/qa-testing-page.mjs",
    "qa:share": "node scripts/qa-testing-page.mjs --share",
    "qa:share:view": "node scripts/qa-testing-page.mjs --share=view",
    "qa:server": "node scripts/qa-testing-page.mjs --server",
    "qa:users": "node scripts/qa-users.mjs",
    "test:suite:queue": "node scripts/run-suite-queue.mjs",
    "test:probe:gate": "node scripts/run-game-probe-gate.mjs",
    "test:regression": "playwright test --project=chromium --workers=1 tests/specs/csf tests/specs/bc tests/specs/ap tests/specs/tm tests/specs/es tests/specs/at tests/specs/fs tests/specs/bf tests/specs/regression",
    "test:regression:staging": "node scripts/run-regression-staging.mjs",
    "test:regression:allure": "node scripts/run-regression-staging.mjs",
    "demo:controllers": "playwright test tests/specs/demo/controllers-walkthrough.spec.ts --project=chromium --headed --workers=1",
    "demo:controllers:staging": "node scripts/run-controllers-demo.mjs",
    "allure:generate": "node scripts/generate-allure-report.mjs",
    "allure:open": "node -e \"import('./scripts/generate-allure-report.mjs').then(m => m.openAllureReport())\"",
    "allure:publish": "node scripts/publish-allure-report.mjs",
    "allure:history": "node -e \"import('./scripts/generate-allure-report.mjs').then(m => m.openAllureReport())\"",
    "test:allure": "pnpm test && pnpm allure:publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/pngjs": "^6.0.5",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.2",
    "playwright": "^1.51.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
