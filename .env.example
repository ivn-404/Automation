# SGAP environment variables (copy to .env — never commit .env)

# Environment config name (config/environments/{SGAP_ENV}.json)
SGAP_ENV=staging

# Game manifest id (config/manifests/{SGAP_GAME_ID}.json)
SGAP_GAME_ID=sugar-wonderland

# Launcher mode: local (offline HTML fixture) | staging (live DiJoker launcher)
SGAP_LAUNCHER_MODE=local

# Staging launcher session (Set user dialog)
SGAP_PLAYER_ID=Automation
SGAP_BRAND_ID=123

# Your name (letters/digits, max 16). Appended to every lane player id so
# testers on different PCs never share a staging player. Required when more
# than one PC runs tests at the same time.
SGAP_TESTER=
